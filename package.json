{
  "name": "kinetic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.contract.test.ts\"",
    "test:gemini": "vitest run src/lib/ai/gemini.contract.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:cloud": "playwright test -c playwright.cloud.config.ts",
    "slop-lint": "node scripts/slop-lint.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-build": "opennextjs-cloudflare build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@clerk/nextjs": "7.9.15",
    "@supabase/supabase-js": "2.117.3",
    "fflate": "0.8.3",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "lucide-react": "1.57.0",
    "motion": "14.3.0",
    "next": "16.3.8",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@clerk/testing": "2.2.47",
    "@opennextjs/cloudflare": "1.20.11",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.10.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  },
  "packageManager": "pnpm@12.3.4"
}
