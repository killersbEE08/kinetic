# Local development with `pnpm dev` (Next.js reads this file).
# Copy to .env.local and fill in. Never commit real keys.
# Every service is optional: with nothing set, the app runs in demo mode
# (decks in localStorage, offline AI, no payments).

# Public URL of the app. Used for checkout return links and Clerk's authorized parties.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (sign-in) -------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: PEM public key for networkless token checks (Clerk → API keys → JWT public key)
CLERK_JWT_KEY=
# Optional: comma-separated origins allowed to send tokens (defaults to NEXT_PUBLIC_APP_URL)
CLERK_AUTHORIZED_PARTIES=

# --- Supabase (database) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by the payment webhook to update plans. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (AI) -----------------------------------------------------------
# Without a key, outlines, slides and edits use the built-in offline engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional cheaper model for free-plan users (e.g. a Flash-Lite model)
GEMINI_MODEL_FREE=

# --- Dodo Payments ---------------------------------------------------------
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Subscription product ids from the Dodo dashboard
DODO_PRODUCT_PRO=
DODO_PRODUCT_TEAM=

# --- Alerts and monitoring (optional) ---------------------------------------
# Email alerts for share-link views and comments (resend.com)
RESEND_API_KEY=
ALERT_EMAIL_FROM=
# Error tracking: Sentry project DSN (https://<key>@<host>/<project>)
SENTRY_DSN=

# --- Abuse reports and bot checks (optional) --------------------------------
# Where deck reports are emailed (needs RESEND_API_KEY and ALERT_EMAIL_FROM)
ABUSE_REPORT_EMAIL=
# Contact address shown on /report for legal requests
NEXT_PUBLIC_ABUSE_EMAIL=
# Where free-tier alerts go (daily cap reached). Defaults to ABUSE_REPORT_EMAIL
OPS_ALERT_EMAIL=
# Extra throwaway email domains to refuse free AI credits (comma-separated)
DISPOSABLE_EMAIL_DOMAINS=
# Cloudflare Turnstile: set both or neither
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
